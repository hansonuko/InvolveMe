# Copy to .env and fill in. Never commit the real .env — see .gitignore.
# Client-safe variables must be prefixed EXPO_PUBLIC_ per Expo convention.
# Anything without that prefix is server-only (Edge Functions / CI) and must
# never be bundled into the mobile app.
#
# Layout note: this file documents every variable used across the monorepo.
# The Expo app only picks up a .env file from its own project root, so the
# EXPO_PUBLIC_* subset also needs to live at apps/mobile/.env (copy them
# there too, or `cp .env apps/mobile/.env`) — see apps/mobile/README.md.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development            # development | staging | production
EXPO_PUBLIC_APP_NAME=InvolveMe

# ---------------------------------------------------------------------------
# Supabase (client-safe: URL + anon key only)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Edge Functions, migrations, CI) — NEVER ship to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

# ---------------------------------------------------------------------------
# Payments — Flutterwave v4 (primary, server-only). OAuth2 client-credentials
# grant against idp.flutterwave.com, not a static Bearer secret key — see
# packages/payments/flutterwave.ts. FLW_CLIENT_ID/FLW_CLIENT_SECRET come from
# the Flutterwave dashboard's API Keys section (sandbox and production have
# SEPARATE credential pairs — don't mix them; sandbox rejects a live token
# and vice versa).
# ---------------------------------------------------------------------------
FLW_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FLW_CLIENT_SECRET=xxxxxxxx
FLW_ENCRYPTION_KEY=xxxxxxxx                # reserved for a future card-tokenization flow, unused by the current bank-transfer-only collection path
FLW_ENVIRONMENT=sandbox                    # sandbox | production — controls which base API host is called
# Pick any long random string yourself and enter the SAME value in the
# Flutterwave dashboard (Settings -> Webhooks) as the endpoint's secret hash.
# Verified as a PLAIN STRING COMPARE against the incoming `verif-hash`
# header — NOT an HMAC/digest of any kind, despite the "hash" in the name.
# This var name and description were wrong for a real stretch of this
# project's history (an HMAC-SHA256-over-the-body / `flutterwave-signature`
# header scheme Flutterwave never actually implements) and that wrongness
# is the reason a real user's top-up sat unconfirmed for weeks, undetected —
# see docs/00-SESSION-HANDOFF.md sessions 3-4 and packages/payments/
# flutterwave.ts's verifyWebhook header comment for the full incident before
# "fixing" this description again. Also: even with the header/algorithm
# correct, don't assume the fix holds — this project's webhook has since
# been confirmed to never actually receive real Flutterwave deliveries at
# all (session 12, likely a dashboard-side misconfiguration outside this
# repo's visibility), which is why fn_confirm_topup no longer depends on it
# alone; see reconcile-topups/check-topup-status below.
FLW_WEBHOOK_SECRET_HASH=xxxxxxxx
# InvolveMe's own transfer "sender" id, created once via POST
# /transfers/senders (required on every payout). Not secret — just a
# provider-issued id with nowhere else in the schema to live.
FLW_TRANSFER_SENDER_ID=sdr_xxxxxxxx

# Shared secret for reconcile-topups' pg_cron -> pg_net -> Edge Function call
# (session 12 — see docs/00-SESSION-HANDOFF.md and that migration's header
# comment). Pick any long random string, set it here (used by
# check-topup-status-function.test.js/reconcile-topups-function.test.js
# locally) AND via `supabase secrets set CRON_INTERNAL_SECRET=...` (what the
# deployed function actually reads) AND
# `select vault.create_secret('<value>', 'cron_internal_secret', '...')`
# against the linked project's DB (what the migration's pg_net call reads)
# — three places, none of them each other, on purpose (a plain
# `app.settings.*` GUC isn't settable on hosted Supabase without superuser,
# which this project's connection role doesn't have).
CRON_INTERNAL_SECRET=xxxxxxxx

# ---------------------------------------------------------------------------
# Payments — Paystack (secondary provider, provisioned behind the
# PaymentProvider interface, not wired to a flag until enabled)
# ---------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_WEBHOOK_SECRET=xxxxxxxx

PAYMENTS_ACTIVE_PROVIDER=flutterwave       # flutterwave | paystack

# ---------------------------------------------------------------------------
# KYC / Identity verification — Prembly, Tier 1 only (BVN/NIN Basic REST
# verification, `x-api-key: PREMBLY_SECRET_KEY`). Prembly also offers a
# native react-native-identity-kyc widget (camera/liveness, Tier 2) that
# this project deliberately doesn't use yet — see
# docs/00-SESSION-HANDOFF.md for why.
# ---------------------------------------------------------------------------
PREMBLY_SECRET_KEY=live_sk_xxxxxxxx         # or test_sk_... if Prembly issues a separate sandbox pair
PREMBLY_PUBLIC_KEY=live_pk_xxxxxxxx         # unused server-side today, only needed by the widget SDK
KYC_HASH_PEPPER=xxxxxxxx                    # mixed into the BVN/NIN hash before storage — never reuse across environments

# ---------------------------------------------------------------------------
# Content moderation — OpenAI's moderation endpoint (packages/moderation/
# openai.ts). Message bodies and status captions are sent to this API for
# screening before send-message/post-status commit them — see
# docs/00-SESSION-HANDOFF.md session 13. Without a real key here,
# send-message/post-status log a moderation-check failure and fail OPEN
# (the send/post still succeeds) rather than block all messaging — see
# those functions' own comments.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxx

# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------
EXPO_PUBLIC_PUSH_PROJECT_ID=your-eas-project-id

# ---------------------------------------------------------------------------
# Media storage / CDN (if not using Supabase Storage directly)
# ---------------------------------------------------------------------------
MEDIA_CDN_BASE_URL=https://cdn.involveme.app

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxxx
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxxx

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
FEATURE_AUTO_WITHDRAWAL_ENABLED=true
FEATURE_STATUS_UPDATES_ENABLED=true
FEATURE_GROUP_CHAT_ENABLED=false           # phased in later, see docs/08-BUILD-PHASES-ROADMAP.md
