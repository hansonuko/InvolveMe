# Copy to .env and fill in. Never commit the real .env — see .gitignore.
# Client-safe variables must be prefixed EXPO_PUBLIC_ per Expo convention.
# Anything without that prefix is server-only (Edge Functions / CI) and must
# never be bundled into the mobile app.
#
# Layout note: this file documents every variable used across the monorepo.
# The Expo app only picks up a .env file from its own project root, so the
# EXPO_PUBLIC_* subset also needs to live at apps/mobile/.env (copy them
# there too, or `cp .env apps/mobile/.env`) — see apps/mobile/README.md.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development            # development | staging | production
EXPO_PUBLIC_APP_NAME=InvolveMe

# ---------------------------------------------------------------------------
# Supabase (client-safe: URL + anon key only)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Edge Functions, migrations, CI) — NEVER ship to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

# ---------------------------------------------------------------------------
# Payments — Flutterwave v4 (primary, server-only). OAuth2 client-credentials
# grant against idp.flutterwave.com, not a static Bearer secret key — see
# packages/payments/flutterwave.ts. FLW_CLIENT_ID/FLW_CLIENT_SECRET come from
# the Flutterwave dashboard's API Keys section (sandbox and production have
# SEPARATE credential pairs — don't mix them; sandbox rejects a live token
# and vice versa).
# ---------------------------------------------------------------------------
FLW_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FLW_CLIENT_SECRET=xxxxxxxx
FLW_ENCRYPTION_KEY=xxxxxxxx                # reserved for a future card-tokenization flow, unused by the current bank-transfer-only collection path
FLW_ENVIRONMENT=sandbox                    # sandbox | production — controls which base API host is called
# Pick any long random string yourself and enter the SAME value in the
# Flutterwave dashboard (Settings -> Webhooks) as the endpoint's secret hash.
# Verified as an HMAC-SHA256 (base64) over the raw webhook body, not a direct
# string compare — see docs/05-API-REALTIME-SPEC.md's webhook-flutterwave section.
FLW_WEBHOOK_SECRET_HASH=xxxxxxxx
# InvolveMe's own transfer "sender" id, created once via POST
# /transfers/senders (required on every payout). Not secret — just a
# provider-issued id with nowhere else in the schema to live.
FLW_TRANSFER_SENDER_ID=sdr_xxxxxxxx

# ---------------------------------------------------------------------------
# Payments — Paystack (secondary provider, provisioned behind the
# PaymentProvider interface, not wired to a flag until enabled)
# ---------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_WEBHOOK_SECRET=xxxxxxxx

PAYMENTS_ACTIVE_PROVIDER=flutterwave       # flutterwave | paystack

# ---------------------------------------------------------------------------
# KYC / Identity verification
# ---------------------------------------------------------------------------
KYC_PROVIDER=your-kyc-vendor               # e.g. Smile Identity, Dojah, VerifyMe
KYC_API_KEY=xxxxxxxx
KYC_API_SECRET=xxxxxxxx

# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------
EXPO_PUBLIC_PUSH_PROJECT_ID=your-eas-project-id

# ---------------------------------------------------------------------------
# Media storage / CDN (if not using Supabase Storage directly)
# ---------------------------------------------------------------------------
MEDIA_CDN_BASE_URL=https://cdn.involveme.app

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxxx
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxxx

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
FEATURE_AUTO_WITHDRAWAL_ENABLED=true
FEATURE_STATUS_UPDATES_ENABLED=true
FEATURE_GROUP_CHAT_ENABLED=false           # phased in later, see docs/08-BUILD-PHASES-ROADMAP.md
