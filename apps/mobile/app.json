{
  "expo": {
    "name": "InvolveMe",
    "slug": "involveme",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "involveme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.involveme.mobile",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "app.involveme.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#5F1B31",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#5F1B31",
      "backgroundColor": "#FDFFF7"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5F1B31",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#5F1B31"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "InvolveMe uses your contacts to show you which of your contacts are already on InvolveMe."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "InvolveMe uses Face ID to keep your account locked when the app isn't in your hands."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "InvolveMe uses your photo library to post a photo status update.",
          "cameraPermission": "InvolveMe uses your camera to post a photo status update."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      "./plugins/withCertPinning.js",
      [
        "expo-audio",
        {
          "microphonePermission": "InvolveMe uses your microphone to record voice messages.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "InvolveMe uses your camera to scan a QR code and link a device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82b1fa24-53c5-4d32-874b-7d3ac93d4410"
      }
    },
    "owner": "hansonuko",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/82b1fa24-53c5-4d32-874b-7d3ac93d4410"
    }
  }
}
