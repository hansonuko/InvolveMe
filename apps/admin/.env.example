# Copy to .env.local (gitignored) for local dev. Every value here is
# server-only — none of it is ever exposed to the browser (no NEXT_PUBLIC_
# prefix on anything, deliberately).

# Same Supabase project as apps/mobile, service-role credentials.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs/verifies the session + pending-MFA JWT cookies (HS256). Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SESSION_SECRET=

# AES-256-GCM key (must decode to exactly 32 bytes) that encrypts TOTP
# secrets at rest — the DB only ever sees ciphertext. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_TOTP_ENCRYPTION_KEY=

# Same Flutterwave credentials supabase/functions/_shared/flutterwave-config.ts
# already reads (see that file's comment for naming history) — required only
# for the treasury-withdrawal apply flow (Phase F piece 3), which calls
# packages/payments' initiatePayout() directly from this app. FLW_WEBHOOK_
# SECRET_HASH is deliberately NOT listed here — this app never receives an
# inbound webhook, only webhook-flutterwave does.
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENVIRONMENT=sandbox
FLW_TRANSFER_SENDER_ID=
